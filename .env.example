# ==========================================
# إعدادات نظام تحليل الأعمال والمنافسين | ASAAS
# ==========================================

# مفتاح أداة البحث الذكي Tavily API (أداة البحث المعتمدة للوكلاء الذكيين)
# احصل على مفتاح مجاني من: https://tavily.com
TAVILY_API_KEY=

# مفتاح مزود النماذج اللغوية (OpenRouter أو Google Gemini)
# احصل على مفتاح OpenRouter من: https://openrouter.ai
OPENROUTER_API_KEY=

# أو مفتاح Google Gemini المباشر من: https://aistudio.google.com
GEMINI_API_KEY=

# النطاق الجغرافي الافتراضي
DEFAULT_REGION="السوق العربي"

# وضع التصحيح (Debug Mode)
DEBUG=false
